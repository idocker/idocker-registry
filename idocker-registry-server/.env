/**
 * iDocker Registry Configuration for Development Environment
 * 
 * The config values will be provided to the server by the config/env.js
 * and in the production environment, the config values will be provided by the docker-compose.yml
 */

# port of the server
PORT=8031
# the env of runtime
NODE_ENV=development

# the dir of the database file
#DB_PATH=./data/registry.db

# 日志配置
# Default log dir is project_root_dir/logs
# LOG_DIR=./logs
# Default log level is info
LOG_LEVEL=debug

# JWT
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=24h

# Docker Registry Config
DOCKER_REGISTRY_URL=http://localhost:7518
DOCKER_REGISTRY_USERNAME=joe
DOCKER_REGISTRY_PASSWORD=menjoy@1975
DOCKER_REGISTRY_TIMEOUT=30000

# idocker registry url
IDOCKER_REGISTRY_URL=http://localhost:8030

# 默认管理员配置
DEFAULT_ADMIN_PASSWORD=admin123
