# IDocker Registry 服务端环境变量配置示例

# 服务器配置
PORT=8031
NODE_ENV=development

# 数据库配置
#DB_PATH=./data/registry.db

# 日志配置
# LOG_DIR=./logs
LOG_LEVEL=info

# JWT配置
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=24h

# Docker Registry配置
DOCKER_REGISTRY_URL=http://localhost:5000
DOCKER_REGISTRY_USERNAME=joe
DOCKER_REGISTRY_PASSWORD=menjoy@1975
DOCKER_REGISTRY_TIMEOUT=30000

# UI配置
UI_URL=http://localhost:8030

# 用户注册配置
ALLOW_USER_REGISTRATION=false

# 默认管理员配置
DEFAULT_ADMIN_PASSWORD=admin123

# CORS配置
CORS_ORIGIN=http://localhost:8030

# 限流配置
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100