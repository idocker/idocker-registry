{
  "name": "idocker-registry",
  "private": true,
  "version": "2.0.4",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "cd idocker-registry-server && npm run dev",
    "build": "vue-tsc --noEmit && vite build",
    "build:server": "cd idocker-registry-server && npm run build",
    "preview": "vite preview",
    "start": "cd idocker-registry-server && npm start",
    "init-db": "cd idocker-registry-server && npm run init-db",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "vue": "^3.3.4",
    "vue-router": "^4.2.4",
    "vue-i18n": "^9.1.9",
    "pinia": "^2.1.6",
    "axios": "^1.5.0",
    "material-design-icons-iconfont": "^6.7.0",
    "@mdi/font": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.5.1",
    "@vitejs/plugin-vue": "^4.3.1",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^11.0.3",
    "@vue/tsconfig": "^0.4.0",
    "concurrently": "^8.2.0",
    "eslint": "^8.46.0",
    "eslint-plugin-vue": "^9.16.1",
    "prettier": "^3.0.0",
    "sass": "^1.65.0",
    "typescript": "~5.1.6",
    "vite": "^4.4.9",
    "vue-tsc": "^1.8.8"
  }
}
