# Docker Registry UI Configuration

# Default Docker Registry URL (empty for production to use relative path)
# Development: http://localhost:8080
# Production: (empty string - use relative path)
VITE_REGISTRY_URL=
#VITE_REGISTRY_URL=http://localhost:8080

# Registry Title (optional)
VITE_REGISTRY_TITLE=iDocker Registry

# Default registries list (comma-separated)
VITE_DEFAULT_REGISTRIES=

# Registry security settings
VITE_REGISTRY_SECURED=true

# UI Features
VITE_DELETE_IMAGES=true
VITE_SHOW_CONTENT_DIGEST=true
VITE_CATALOG_ELEMENTS_LIMIT=1000
VITE_SINGLE_REGISTRY=true
VITE_READ_ONLY_REGISTRIES=false
VITE_SHOW_CATALOG_NB_TAGS=true
VITE_USE_CONTROL_CACHE_HEADER=true
VITE_THEME=auto
VITE_TAGLIST_ORDER=alpha-asc;num-desc
VITE_CATALOG_DEFAULT_EXPANDED=false
VITE_CATALOG_MIN_BRANCHES=1
VITE_CATALOG_MAX_BRANCHES=1
VITE_TAGLIST_PAGE_SIZE=100
VITE_SHOW_TAG_HISTORY=true

# Pull URL (optional, defaults to registry URL without protocol)
# VITE_PULL_URL=localhost:8080