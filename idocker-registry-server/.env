# IDocker Registry 服务端环境变量配置示例

# 服务器配置
PORT=8080
NODE_ENV=production
LOG_LEVEL=info

# 数据库配置
DB_PATH=/app/data/registry.db

# 日志配置
LOG_DIR=/app/logs
LOG_LEVEL=info

# JWT配置
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=24h

# Docker Registry配置（内部通信，不需要认证）
REGISTRY_URL=http://localhost:5000
REGISTRY_TIMEOUT=60000

# UI配置（容器内使用相对路径）
UI_URL=

# 用户注册配置
ALLOW_USER_REGISTRATION=false

# 默认管理员配置
DEFAULT_ADMIN_PASSWORD=admin123

# CORS配置（生产环境不需要跨域）
CORS_ORIGIN=

# 限流配置
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000